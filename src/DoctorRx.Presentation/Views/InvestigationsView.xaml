<UserControl x:Class="DoctorRx.Presentation.Views.InvestigationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DoctorRx.Presentation.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:InvestigationsViewModel}"
             d:DesignHeight="900" d:DesignWidth="1250"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Grid Background="{StaticResource SlateBackgroundBrush}">
        <!-- Main Container -->
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <!-- 0: Top Header & View Mode Switcher -->
                <RowDefinition Height="Auto" />
                <!-- 1: Notification & Validation Banners -->
                <RowDefinition Height="Auto" />
                <!-- 2: Scrollable Main Content -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= TOP HEADER ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Diagnostic Investigations &amp; Lab Orders" Style="{StaticResource HeadingLarge}" />
                    <TextBlock Text="Prescribe diagnostic imaging, clinical pathology, biochemistry, and diagnostic tests."
                               Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Navigation Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" 
                            Command="{Binding ToggleViewModeCommand}" 
                            Padding="14,8" Margin="0,0,10,0"
                            AutomationProperties.Name="Toggle View Mode Button">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconHistory}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource SlateDarkBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HistoryTabButtonText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}" 
                            Command="{Binding ClearOrderCommand}" 
                            Padding="12,8" ToolTip="Reset current order fields"
                            Visibility="{Binding IsHistoryView, Converter={StaticResource InverseBoolToVisConverter}}"
                            AutomationProperties.Name="Reset Order Form Button">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource SlateMediumBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Clear Form" Style="{StaticResource CaptionMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= NOTIFICATIONS BANNER ================= -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <!-- Success Banner -->
                <Border Background="#E6F4EA" BorderBrush="#34A853" BorderThickness="1" CornerRadius="6" Padding="14,10"
                        Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconCheckCircle}" Width="16" Height="16" Stretch="Uniform" Fill="#137333" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SuccessMessage}" Foreground="#137333" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding DismissBannerCommand}" Padding="6,2" VerticalAlignment="Center" ToolTip="Dismiss notification">
                            <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform" Fill="#137333" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Validation Error Banner -->
                <Border Background="#FCE8E6" BorderBrush="#EA4335" BorderThickness="1" CornerRadius="6" Padding="14,10"
                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconWarning}" Width="16" Height="16" Stretch="Uniform" Fill="#C5221F" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ValidationErrorMessage}" Foreground="#C5221F" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding DismissBannerCommand}" Padding="6,2" VerticalAlignment="Center" ToolTip="Dismiss alert">
                            <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform" Fill="#C5221F" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ================= MODE 1: DIRECT PRESCRIBING WORKFLOW ================= -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsHistoryView, Converter={StaticResource InverseBoolToVisConverter}}">
                <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,24">

                    <!-- 1. PATIENT INFORMATION CARD -->
                    <Border Style="{StaticResource CardContainer}" Padding="16,14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="PATIENT INFORMATION" Style="{StaticResource CaptionMuted}" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button Content="Change Patient" Command="{Binding ChangePatientCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                        Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolToVisConverter}}" Padding="12,4" FontSize="12" />
                            </Grid>

                            <!-- If No Patient Selected: Search Field & Suggestions Dropdown -->
                            <StackPanel Visibility="{Binding HasSelectedPatient, Converter={StaticResource InverseBoolToVisConverter}}">
                                <TextBox Text="{Binding PatientSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource SearchBox}" 
                                         Tag="Search patient by name, MR number, or phone..." 
                                         AutomationProperties.Name="Patient Search Box" />

                                <!-- Dropdown Search Suggestions -->
                                <Border Background="White" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1" CornerRadius="6"
                                        MaxHeight="220" Margin="0,6,0,0"
                                        Visibility="{Binding HasPatientSearchResults, Converter={StaticResource BoolToVisConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding PatientSearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource SlateBorderLightBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- MRN Badge -->
                                                            <Border Grid.Column="0" Background="#F0FDFA" BorderBrush="{StaticResource PrimaryTealLightBrush}" 
                                                                    BorderThickness="1" CornerRadius="4" Padding="7,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RecordNumber}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryTealDarkBrush}" FontFamily="Consolas, Segoe UI" />
                                                            </Border>

                                                            <!-- Demographics -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource SlateDarkestBrush}" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding DisplayAgeGender}" Style="{StaticResource CaptionMuted}" />
                                                                    <TextBlock Text=" • " Style="{StaticResource CaptionMuted}" />
                                                                    <TextBlock Text="{Binding FormattedPhone}" Style="{StaticResource CaptionMuted}" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Select Button -->
                                                            <Button Grid.Column="2" 
                                                                    Content="Select" 
                                                                    Command="{Binding DataContext.SelectPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                    CommandParameter="{Binding}" 
                                                                    Style="{StaticResource PrimaryButton}" 
                                                                    Padding="14,6" FontSize="11.5"
                                                                    VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <!-- Selected Patient Summary Card -->
                            <Border Background="{StaticResource SlateBackgroundBrush}" BorderBrush="{StaticResource SlateBorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10"
                                    Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolToVisConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PatientDisplayName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SlateDarkestBrush}" Margin="0,0,10,0" />
                                        <Border Background="{StaticResource PrimaryTealUltraLightBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding PatientMrn}" FontWeight="Bold" Foreground="{StaticResource PrimaryTealDarkBrush}" FontSize="11" />
                                        </Border>
                                        <TextBlock Text="{Binding PatientAgeGender}" Foreground="{StaticResource SlateMediumBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="•" Foreground="{StaticResource SlateLightBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding PatientPhone}" Foreground="{StaticResource SlateMediumBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding RequestDate, StringFormat='Order Date: {0:dd MMM yyyy}'}" Style="{StaticResource CaptionMuted}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. DIRECT INVESTIGATION INPUT EDITOR -->
                    <Border Style="{StaticResource CardContainer}" Padding="18,16" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Editor Header -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EditorHeaderTitle}" Style="{StaticResource HeadingSmall}" />
                                    <TextBlock Text="— Doctor directly enters required investigation details" Style="{StaticResource CaptionMuted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Content="Cancel Edit" Command="{Binding CancelEditInvestigationCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                        Visibility="{Binding IsEditingItem, Converter={StaticResource BoolToVisConverter}}" Padding="12,3" FontSize="11.5" />
                            </Grid>

                            <!-- Inline Editor Error Banner -->
                            <Border Background="{StaticResource DangerRedLightBrush}" BorderBrush="{StaticResource DangerRedBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12"
                                    Visibility="{Binding HasEditorError, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconWarning}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource DangerRedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EditorErrorMessage}" Foreground="{StaticResource DangerRedBrush}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Row 1: Test Name & Category -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" MinWidth="220" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1.2*" MinWidth="160" />
                                </Grid.ColumnDefinitions>

                                <!-- Test / Investigation Name Input -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Investigation / Test Name *" Style="{StaticResource CaptionMuted}" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditorInvestigationName, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource SearchBox}" 
                                             Tag="Enter Investigation / Test Name * (e.g. Chest X-Ray PA, Complete Blood Count, USG Abdomen)" 
                                             AutomationProperties.Name="Investigation Name Input" />
                                </StackPanel>

                                <!-- Category Selection -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Diagnostic Category" Style="{StaticResource CaptionMuted}" FontWeight="Bold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableCategories}" 
                                              SelectedItem="{Binding EditorCategory, Mode=TwoWay}"
                                              Height="38" VerticalContentAlignment="Center"
                                              AutomationProperties.Name="Investigation Category ComboBox" />
                                </StackPanel>
                            </Grid>

                            <!-- Quick Category Selection Chips -->
                            <WrapPanel Margin="0,0,0,12">
                                <TextBlock Text="Quick Categories:" Style="{StaticResource CaptionMuted}" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <Button Content="🔬 Laboratory" Command="{Binding SelectCategoryChipCommand}" CommandParameter="Laboratory" Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="0,0,6,4" FontSize="11" />
                                <Button Content="🩻 Radiology &amp; Imaging" Command="{Binding SelectCategoryChipCommand}" CommandParameter="Radiology &amp; Imaging" Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="0,0,6,4" FontSize="11" />
                                <Button Content="❤️ Cardiology &amp; Diagnostics" Command="{Binding SelectCategoryChipCommand}" CommandParameter="Cardiology &amp; Diagnostics" Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="0,0,6,4" FontSize="11" />
                                <Button Content="📋 Other Diagnostics" Command="{Binding SelectCategoryChipCommand}" CommandParameter="Other Diagnostics" Style="{StaticResource SecondaryButton}" Padding="7,2" Margin="0,0,6,4" FontSize="11" />
                            </WrapPanel>

                            <!-- Row 2: Anatomical Site / Specimen & Protocol / Fasting Directives -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                </Grid.ColumnDefinitions>

                                <!-- Anatomical Site / Target Region / Specimen -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Anatomical Site / Specimen (Optional)" Style="{StaticResource CaptionMuted}" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditorBodyPartOrSite, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource SearchBox}" 
                                             Tag="e.g. Fasting Venous Blood, Chest, Urine, Right Knee, Abdomen, Cervical Spine" 
                                             AutomationProperties.Name="Body Part Or Specimen Input" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Blood" Command="{Binding SelectSiteChipCommand}" CommandParameter="Venous Blood" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="10.5" />
                                        <Button Content="Urine" Command="{Binding SelectSiteChipCommand}" CommandParameter="Midstream Urine" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="10.5" />
                                        <Button Content="Chest" Command="{Binding SelectSiteChipCommand}" CommandParameter="Chest" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="10.5" />
                                        <Button Content="Abdomen" Command="{Binding SelectSiteChipCommand}" CommandParameter="Whole Abdomen" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="10.5" />
                                        <Button Content="Spine" Command="{Binding SelectSiteChipCommand}" CommandParameter="Lumbar Spine" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="10.5" />
                                        <Button Content="Knee" Command="{Binding SelectSiteChipCommand}" CommandParameter="Knee Joint" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="10.5" />
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Views / Examination Protocol / Fasting Directive -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Views / Protocol / Fasting (Optional)" Style="{StaticResource CaptionMuted}" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditorViewOrProtocol, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource SearchBox}" 
                                             Tag="e.g. PA &amp; Lateral Views, 10-12h Fasting, Non-Contrast, STAT, 2h Post-Prandial" 
                                             AutomationProperties.Name="Views Or Protocol Input" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="10-12h Fasting" Command="{Binding SelectProtocolChipCommand}" CommandParameter="10-12h Overnight Fasting" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="10.5" />
                                        <Button Content="PA &amp; Lateral" Command="{Binding SelectProtocolChipCommand}" CommandParameter="PA &amp; Lateral Views" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="10.5" />
                                        <Button Content="Non-Contrast" Command="{Binding SelectProtocolChipCommand}" CommandParameter="Plain (Non-Contrast)" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="10.5" />
                                        <Button Content="STAT / Urgent" Command="{Binding SelectProtocolChipCommand}" CommandParameter="STAT / Urgent" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="10.5" />
                                        <Button Content="Random" Command="{Binding SelectProtocolChipCommand}" CommandParameter="Random" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="10.5" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Specific Clinical Instructions / Reason -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Specific Directives / Clinical Suspicion / Rule-Out (Optional)" Style="{StaticResource CaptionMuted}" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditorSpecificInstructions, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource SearchBox}" 
                                         Tag="e.g. Rule out consolidation, Pre-op surgical workup, Baseline trend, Chronic pain evaluation" 
                                         AutomationProperties.Name="Specific Instructions Input" />
                            </StackPanel>

                            <!-- Row 4: Submit / Add Button -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding AddOrUpdateInvestigationButtonText}" 
                                        Command="{Binding AddOrUpdateInvestigationCommand}" 
                                        Style="{StaticResource PrimaryButton}" 
                                        Padding="22,9" FontSize="13" FontWeight="Bold"
                                        AutomationProperties.Name="Add Investigation Button" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. PRESCRIBED DIAGNOSTIC INVESTIGATIONS TABLE -->
                    <Border Style="{StaticResource CardContainer}" Padding="18,16" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Header with Count -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="PRESCRIBED DIAGNOSTIC INVESTIGATIONS" Style="{StaticResource CaptionMuted}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Border Background="{StaticResource PrimaryTealBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedInvestigationCount}" Foreground="White" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="These items will appear on the printed requisition slip" Style="{StaticResource CaptionMuted}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Empty State -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource SlateBorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="24,20"
                                    Visibility="{Binding HasSelectedInvestigations, Converter={StaticResource InverseBoolToVisConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconInvestigation}" Width="36" Height="36" Stretch="Uniform" Fill="{StaticResource SlateLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="No investigations prescribed yet." FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SlateMediumBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Write the test name in the input field above and click '+ Add Investigation to Order'." Style="{StaticResource CaptionMuted}" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Prescribed Items List -->
                            <ItemsControl ItemsSource="{Binding SelectedInvestigations}"
                                          Visibility="{Binding HasSelectedInvestigations, Converter={StaticResource BoolToVisConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="{StaticResource SlateBorderLightBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Line Number Badge -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <!-- Details -->
                                                    <ColumnDefinition Width="*" />
                                                    <!-- Actions: Edit & Delete -->
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Line Number Circle -->
                                                <Border Grid.Column="0" Background="{StaticResource PrimaryTealUltraLightBrush}" CornerRadius="12" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ItemNumber, StringFormat='#{0}'}" FontWeight="Bold" Foreground="{StaticResource PrimaryTealDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                                </Border>

                                                <!-- Test Name & Formatted Directives -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding InvestigationName}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SlateDarkestBrush}" Margin="0,0,8,0" />
                                                        
                                                        <!-- Category Pill Badge -->
                                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SlateDarkBrush}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Formatted Site & Protocol -->
                                                    <TextBlock Text="{Binding FormattedDetails}" FontWeight="Medium" Foreground="{StaticResource SlateDarkBrush}" FontSize="12" Margin="0,3,0,0"
                                                               Visibility="{Binding HasFormattedDetails, Converter={StaticResource BoolToVisConverter}}" />

                                                    <!-- Specific Instructions -->
                                                    <TextBlock Text="{Binding SpecificInstructions, StringFormat='Directives: {0}'}" FontSize="11.5" Foreground="{StaticResource PrimaryTealDarkBrush}" FontStyle="Italic" Margin="0,2,0,0"
                                                               Visibility="{Binding HasSpecificInstructions, Converter={StaticResource BoolToVisConverter}}" />
                                                </StackPanel>

                                                <!-- Edit & Delete Action Buttons -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.EditInvestigationRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" ToolTip="Edit this investigation">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconEdit}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource SlateDarkBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Edit" FontSize="11" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Command="{Binding DataContext.DeleteInvestigationRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostButton}" Padding="6,4" ToolTip="Remove from order">
                                                        <Path Data="{StaticResource IconTrash}" Width="14" Height="14" Stretch="Uniform" Fill="#EF4444" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 4. CLINICAL INDICATION & PATIENT PREPARATION DIRECTIVES -->
                    <Border Style="{StaticResource CardContainer}" Padding="18,16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Clinical Notes / Reason for Testing -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CLINICAL NOTES / REASON FOR TESTING" Style="{StaticResource CaptionMuted}" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ClinicalNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SearchBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         Tag="e.g. Persistent cough x 3 weeks, Fever of unknown origin, Pre-op baseline"
                                         VerticalScrollBarVisibility="Auto" Padding="8,6" FontSize="12"
                                         AutomationProperties.Name="Clinical Notes Input" />
                            </StackPanel>

                            <!-- Patient Instructions & Preparation Directives -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PATIENT PREPARATION &amp; DIRECTIVES" Style="{StaticResource CaptionMuted}" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding GeneralInstructions, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SearchBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         Tag="e.g. Drink 1L water 1h prior for pelvic ultrasound, 10-12h overnight fasting"
                                         VerticalScrollBarVisibility="Auto" Padding="8,6" FontSize="12"
                                         AutomationProperties.Name="Patient Instructions Input" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 5. ACTION TOOLBAR -->
                    <Border Style="{StaticResource CardContainer}" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Clear Form" 
                                    Command="{Binding ClearOrderCommand}" 
                                    Style="{StaticResource SecondaryButton}" Padding="14,8"
                                    AutomationProperties.Name="Clear Order Button" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <!-- Print Preview -->
                                <Button Command="{Binding PrintPreviewOrderCommand}" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Padding="14,8" Margin="0,0,10,0"
                                        AutomationProperties.Name="Print Preview Order Button">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconZoomFit}" Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource SlateDarkBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Preview" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Save Only -->
                                <Button Content="Save Request" 
                                        Command="{Binding SaveOrderCommand}" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Padding="14,8" Margin="0,0,10,0"
                                        AutomationProperties.Name="Save Order Button" />

                                <!-- Save & Print Direct -->
                                <Button Command="{Binding PrintOrderDirectCommand}" 
                                        Style="{StaticResource PrimaryButton}" 
                                        Padding="18,8"
                                        AutomationProperties.Name="Save and Print Order Button">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPrint}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Save &amp; Print" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ================= MODE 2: ORDER HISTORY & ARCHIVE ================= -->
            <Grid Grid.Row="2" Visibility="{Binding IsHistoryView, Converter={StaticResource BoolToVisConverter}}">
                <Grid.ColumnDefinitions>
                    <!-- History Request Table (60%) -->
                    <ColumnDefinition Width="6*" MinWidth="450" />
                    <ColumnDefinition Width="16" />
                    <!-- Selected Request Preview (40%) -->
                    <ColumnDefinition Width="4*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: HISTORY TABLE -->
                <Border Grid.Column="0" Style="{StaticResource CardContainer}" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Search & Date Filter Bar -->
                            <RowDefinition Height="Auto" />
                            <!-- Requests Table -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Filter Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search query -->
                            <TextBox Grid.Column="0" Text="{Binding HistorySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SearchBox}"
                                     Tag="Search patient or order #..."
                                     AutomationProperties.Name="History Search Query Input" />

                            <!-- From Date -->
                            <DatePicker Grid.Column="2" SelectedDate="{Binding HistoryFromDate, Mode=TwoWay}"
                                        ToolTip="From Date" AutomationProperties.Name="History From Date Picker" />

                            <!-- To Date -->
                            <DatePicker Grid.Column="4" SelectedDate="{Binding HistoryToDate, Mode=TwoWay}"
                                        ToolTip="To Date" AutomationProperties.Name="History To Date Picker" />

                            <!-- Clear / Filter Buttons -->
                            <StackPanel Grid.Column="6" Orientation="Horizontal">
                                <Button Content="Filter" Command="{Binding RefreshHistoryCommand}" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,6,0" />
                                <Button Content="Reset" Command="{Binding ClearHistoryFilterCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" />
                            </StackPanel>
                        </Grid>

                        <!-- Requests List / Table -->
                        <Border Grid.Row="1" Background="{StaticResource SlateBackgroundBrush}" CornerRadius="6" BorderBrush="{StaticResource SlateBorderLightBrush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding HistoryRequests}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="5" BorderBrush="{StaticResource SlateBorderLightBrush}" BorderThickness="1" Margin="4,3" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding RequestNumber}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource SlateDarkestBrush}" />
                                                            <TextBlock Text="•" Margin="8,0" Style="{StaticResource CaptionMuted}" />
                                                            <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTealBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding FormattedDate}" Style="{StaticResource CaptionMuted}" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding PatientMrn}" Style="{StaticResource CaptionMuted}" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CaptionMuted}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Border Grid.Column="1" Background="#EEF2F6" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="10,0">
                                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SlateDarkBrush}" />
                                                    </Border>

                                                    <Button Grid.Column="2" Content="View" 
                                                            Command="{Binding DataContext.SelectHistoryRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT: SELECTED DETAIL PREVIEW -->
                <Border Grid.Column="2" Style="{StaticResource CardContainer}" Padding="16,14">
                    <Grid>
                        <!-- When no item selected -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasSelectedHistoryRequest, Converter={StaticResource InverseBoolToVisConverter}}">
                            <Path Data="{StaticResource IconInvestigation}" Width="36" Height="36" Stretch="Uniform" Fill="{StaticResource SlateLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="Select a request to view details" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SlateMediumBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- When detail is loaded -->
                        <Grid Visibility="{Binding HasSelectedHistoryRequest, Converter={StaticResource BoolToVisConverter}}">
                            <Grid.RowDefinitions>
                                <!-- Detail Header -->
                                <RowDefinition Height="Auto" />
                                <!-- Items List -->
                                <RowDefinition Height="*" />
                                <!-- Notes & Reprint Button -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedRequestDetail.RequestNumber}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource SlateDarkestBrush}" />
                                <TextBlock Text="{Binding SelectedRequestDetail.FormattedDate}" Style="{StaticResource CaptionMuted}" Margin="0,2,0,6" />
                                <Border Background="#F1F5F9" CornerRadius="4" Padding="10,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedRequestDetail.PatientName}" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="{Binding SelectedRequestDetail.PatientMrn}" Style="{StaticResource CaptionMuted}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Ordered items in detail -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                                <ItemsControl ItemsSource="{Binding SelectedRequestDetail.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource SlateBorderLightBrush}" BorderThickness="0,0,0,1" Padding="6,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding InvestigationName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource SlateDarkestBrush}" />
                                                    <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionMuted}" FontSize="11" Foreground="{StaticResource PrimaryTealBrush}" />
                                                    <TextBlock Text="{Binding FormattedDetails}" Style="{StaticResource CaptionMuted}" FontSize="11" Visibility="{Binding HasFormattedDetails, Converter={StaticResource BoolToVisConverter}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Clinical notes & Reprint -->
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="{Binding SelectedRequestDetail.ClinicalNotes, StringFormat='Notes: {0}'}" 
                                           Style="{StaticResource CaptionMuted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Visibility="{Binding SelectedRequestDetail.ClinicalNotes, Converter={StaticResource BoolToVisConverter}}" />

                                <Button Command="{Binding ReprintRequestCommand}" 
                                        Style="{StaticResource PrimaryButton}" 
                                        Padding="14,8" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Reprint Request Button">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconPrint}" Width="13" Height="13" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Print / Preview Request" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
