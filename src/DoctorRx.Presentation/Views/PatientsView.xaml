<UserControl x:Class="DoctorRx.Presentation.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DoctorRx.Presentation.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PatientsViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100">

    <Grid Margin="30,24,30,30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!-- Side Drawer Column for Registering/Editing -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left / Main Patient Directory Area -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search and Action Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Grid Grid.Column="0">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Padding="36,9,28,9" />
                    <!-- Search Icon Symbol -->
                    <TextBlock Text="🔍" FontSize="12" Foreground="{StaticResource SlateLightBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                               IsHitTestVisible="False" />
                    <!-- Clear Button -->
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearSearchCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,6,0" Padding="6,2" BorderThickness="0"
                            Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource SlateLightBrush}" />
                    </Button>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,10,0" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenNewPatientDrawerCommand}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+ " FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="Register New Patient" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Search Error Banner -->
            <Border Grid.Row="0" Background="{StaticResource DangerRedLightBrush}"
                    BorderBrush="{StaticResource DangerRedBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,14"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding HasSearchError, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding SearchErrorMessage}" 
                           Foreground="{StaticResource DangerRedBrush}" 
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- Patients Table -->
            <Border Grid.Row="1" Style="{StaticResource CardContainer}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Patients}"
                              SelectedItem="{Binding SelectedPatient}"
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MRN" Binding="{Binding Id, StringFormat='#{0}'}" Width="80" />
                            <DataGridTextColumn Header="Patient Name" Binding="{Binding Name}" Width="1.5*" />
                            <DataGridTextColumn Header="Age" Binding="{Binding Age, StringFormat='{}{0} yrs'}" Width="90" />
                            <DataGridTemplateColumn Header="Gender" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Gender}" FontSize="12" Foreground="{StaticResource SlateDarkBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Phone" Binding="{Binding FormattedPhone}" Width="130" />
                            <DataGridTextColumn Header="Address / City" Binding="{Binding Address}" Width="1.5*" />
                            
                            <!-- Row Actions Column -->
                            <DataGridTemplateColumn Header="Actions" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Edit"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.EditPatientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,3" FontSize="11.5" Margin="0,0,6,0" />
                                            
                                            <Button Content="+ Rx"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding DataContext.CreatePrescriptionForPatientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,3" FontSize="11.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Table Footer: Paging and Count Summary -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <TextBlock Text="{Binding Patients.Count, StringFormat='Showing {0} loaded records'}"
                                       Foreground="{StaticResource SlateMutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" />

                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding LoadMorePatientsCommand}"
                                    HorizontalAlignment="Right" Padding="12,5"
                                    Visibility="{Binding HasMorePatients, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Load More Patients (Next 50)" FontSize="12" FontWeight="SemiBold" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Side Drawer / Registration Panel -->
        <Border Grid.Column="1" 
                Width="380"
                Style="{StaticResource CardContainer}"
                Padding="24"
                Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVisConverter}}">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Drawer Header -->
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="{Binding DrawerTitle}" Style="{StaticResource HeadingSmall}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding CloseDrawerCommand}"
                                HorizontalAlignment="Right" Padding="8,4" BorderThickness="0">
                            <TextBlock Text="✕" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Error Alert Banner -->
                    <Border Background="{StaticResource DangerRedLightBrush}"
                            BorderBrush="{StaticResource DangerRedBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding FormErrorMessage}" 
                                   Foreground="{StaticResource DangerRedBrush}" 
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- Patient Name -->
                    <TextBlock Text="Patient Full Name *" Style="{StaticResource BodyMuted}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,14" />

                    <!-- Age and Gender Row -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Age (Years)" Style="{StaticResource BodyMuted}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox Text="{Binding FormAge, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                                     Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Gender" Style="{StaticResource BodyMuted}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding AvailableGenders}"
                                      SelectedItem="{Binding FormGender}"
                                      Style="{StaticResource ModernComboBox}" />
                        </StackPanel>
                    </Grid>

                    <!-- Phone Number -->
                    <TextBlock Text="Contact Number" Style="{StaticResource BodyMuted}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,14" />

                    <!-- Address -->
                    <TextBlock Text="Address / Location" Style="{StaticResource BodyMuted}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,14" />

                    <!-- Known Allergies -->
                    <TextBlock Text="Known Drug Allergies" Style="{StaticResource BodyMuted}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding FormKnownAllergies, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,14" />

                    <!-- Medical History Notes -->
                    <TextBlock Text="Medical History Notes" Style="{StaticResource BodyMuted}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding FormMedicalHistory, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" Height="70"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" Margin="0,0,0,24" />

                    <!-- Drawer Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Cancel" 
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CloseDrawerCommand}" />

                        <Button Grid.Column="2" Content="Save Patient" 
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SavePatientCommand}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
