<UserControl x:Class="DoctorRx.Presentation.Views.PrescriptionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DoctorRx.Presentation.ViewModels"
             xmlns:models="clr-namespace:DoctorRx.Domain.Models;assembly=DoctorRx.Domain"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PrescriptionHistoryViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             AutomationProperties.Name="Prescription History View">

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <!-- Row 0: Search & Filters Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Prescription Table / Content -->
            <RowDefinition Height="*" />
            <!-- Row 2: Pagination Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= SEARCH & FILTERS TOOLBAR ================= -->
        <Border Grid.Row="0" Margin="0,0,0,16" Background="{StaticResource SurfaceWhiteBrush}"
                BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
            <StackPanel Orientation="Vertical">
                <!-- Top Row: Search Box, Preset, Status, Sort, Clear, Refresh -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <Grid Width="280" Margin="0,0,12,8">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Padding="36,9,28,9"
                                 AutomationProperties.Name="Search Prescriptions Input" />
                        <Path Data="{StaticResource IconSearch}" Width="14" Height="14" Stretch="Uniform" 
                              Fill="{StaticResource SlateLightBrush}"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                              IsHitTestVisible="False" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearSearchCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,6,0" Padding="6,4" BorderThickness="0"
                                Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisConverter}}"
                                AutomationProperties.Name="Clear Prescription Search">
                            <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform" Fill="{StaticResource SlateLightBrush}" />
                        </Button>
                    </Grid>

                    <!-- Date Preset Dropdown -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8">
                        <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource SlateMediumBrush}" />
                        <ComboBox ItemsSource="{Binding AvailableDatePresets}"
                                  SelectedItem="{Binding DatePreset}"
                                  Height="36" Width="130"
                                  VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Filter Prescriptions By Date Preset">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Status Filter Dropdown -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8">
                        <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource SlateMediumBrush}" />
                        <ComboBox ItemsSource="{Binding AvailableStatusFilters}"
                                  SelectedItem="{Binding StatusFilter}"
                                  Height="36" Width="150"
                                  VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Filter Prescriptions By Status">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Sort Option Dropdown -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8">
                        <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource SlateMediumBrush}" />
                        <ComboBox ItemsSource="{Binding AvailableSortOptions}"
                                  SelectedItem="{Binding SortOption}"
                                  Height="36" Width="160"
                                  VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Sort Prescriptions Order">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Include Replaced CheckBox -->
                    <CheckBox IsChecked="{Binding IncludeReplaced}"
                              Content="Include replaced"
                              VerticalAlignment="Center"
                              Margin="0,0,14,8"
                              FontSize="{StaticResource FontSizeCaption}"
                              Foreground="{StaticResource SlateMediumBrush}"
                              AutomationProperties.Name="Include Replaced Prescriptions Checkbox" />

                    <!-- Clear Filters Button -->
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearFiltersCommand}"
                            Margin="0,0,8,8" Padding="10,6"
                            ToolTip="Clear all active filters and search query"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisConverter}}"
                            AutomationProperties.Name="Clear All Active Prescription Filters">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform" Fill="{StaticResource SlateMediumBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Clear Filters" FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,0,8" Padding="12,8"
                            ToolTip="Refresh Prescription History"
                            AutomationProperties.Name="Refresh Prescription History">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource SlateMediumBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Custom Date Range Pickers (Visible when DatePreset == Custom) -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,6,0,0"
                            Visibility="{Binding IsCustomDateRange, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="Custom Range:" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource SlateDarkBrush}" />
                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,4,0"
                               FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource SlateMediumBrush}" />
                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                Width="130" Height="34" Margin="0,0,12,0"
                                AutomationProperties.Name="Custom From Date Picker" />
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,4,0"
                               FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource SlateMediumBrush}" />
                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                Width="130" Height="34"
                                AutomationProperties.Name="Custom To Date Picker" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= MAIN TABLE / CONTENT ================= -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceWhiteBrush}"
                BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <!-- Prescriptions DataGrid -->
                <DataGrid x:Name="PrescriptionsGrid"
                          ItemsSource="{Binding Prescriptions}"
                          SelectedItem="{Binding SelectedPrescription}"
                          Style="{StaticResource ModernDataGrid}"
                          AutomationProperties.Name="Prescriptions History DataGrid">
                    <DataGrid.Columns>
                        <!-- Prescription Number -->
                        <DataGridTemplateColumn Header="Prescription #" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="0" HorizontalAlignment="Left"
                                            AutomationProperties.Name="View Prescription Details">
                                        <TextBlock Text="{Binding PrescriptionNumber}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTealDarkBrush}"
                                                   TextDecorations="Underline" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Date -->
                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding PrescriptionDate, StringFormat='{}{0:dd MMM yyyy}'}"
                                            Width="120" />

                        <!-- Patient Name -->
                        <DataGridTextColumn Header="Patient Name"
                                            Binding="{Binding PatientName}"
                                            Width="*" MinWidth="150" />

                        <!-- Patient Record # / MRN -->
                        <DataGridTextColumn Header="Patient MRN"
                                            Binding="{Binding PatientRecordNumber}"
                                            Width="110" />

                        <!-- Items Count -->
                        <DataGridTextColumn Header="Medicines"
                                            Binding="{Binding MedicineCount}"
                                            Width="85" />

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Status" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Background="#F1F5F9">
                                        <TextBlock Text="{Binding StatusDisplayText}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource SlateDarkBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions (View, Print, Save as PDF) -->
                        <DataGridTemplateColumn Header="Actions" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- View Detail Button -->
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4" Margin="0,0,4,0"
                                                ToolTip="View full prescription details"
                                                AutomationProperties.Name="View Prescription Details Button">
                                            <TextBlock Text="View" FontSize="{StaticResource FontSizeCaption}" />
                                        </Button>

                                        <!-- Print Preview Button -->
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.PrintPrescriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4" Margin="0,0,4,0"
                                                ToolTip="Print or preview prescription"
                                                AutomationProperties.Name="Print Prescription Button">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconPrint}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource SlateMediumBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Print" FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Save as PDF Button (Disabled per Gate 1 spec) -->
                                        <Button Style="{StaticResource SecondaryButton}"
                                                IsEnabled="False"
                                                Padding="8,4"
                                                ToolTip="Export to PDF will be available once document rendering is finalized (Gate 1)."
                                                AutomationProperties.Name="Save Prescription As PDF Button">
                                            <TextBlock Text="PDF" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource SlateLightBrush}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding TotalCount, Converter={StaticResource CountToZeroVisConverter}}">
                    <Path Data="{StaticResource IconHistory}" Width="48" Height="48" Stretch="Uniform"
                          Fill="{StaticResource SlateLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="No prescriptions found"
                               Style="{StaticResource HeadingSmall}" HorizontalAlignment="Center" Foreground="{StaticResource SlateMediumBrush}" />
                    <TextBlock Text="Try adjusting your search criteria, dates, or status filters."
                               Style="{StaticResource CaptionMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Loading Overlay -->
                <Border Background="#80FFFFFF"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="Loading prescriptions..."
                               Style="{StaticResource HeadingSmall}"
                               Foreground="{StaticResource PrimaryTealDarkBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ================= PAGINATION BAR ================= -->
        <Border Grid.Row="2" Margin="0,14,0,0" Background="{StaticResource SurfaceWhiteBrush}"
                BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Summary Text (e.g. Showing 1 - 50 of 1,234 prescriptions) -->
                <TextBlock Grid.Column="0"
                           Text="{Binding PageSummaryText}"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeBodyMuted}"
                           Foreground="{StaticResource SlateMutedBrush}"
                           AutomationProperties.Name="Prescriptions Pagination Summary" />

                <!-- Pagination Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- First Page -->
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding FirstPageCommand}"
                            Padding="8,5" Margin="0,0,4,0"
                            ToolTip="First Page"
                            AutomationProperties.Name="First Page Button">
                        <TextBlock Text="&#171;" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    </Button>

                    <!-- Previous Page -->
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding PreviousPageCommand}"
                            Padding="8,5" Margin="0,0,8,0"
                            ToolTip="Previous Page"
                            AutomationProperties.Name="Previous Page Button">
                        <Path Data="{StaticResource IconArrowBack}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource SlateMediumBrush}" VerticalAlignment="Center" />
                    </Button>

                    <!-- Page Number Indicator -->
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource SlateDarkBrush}">
                        <Run Text="Page " />
                        <Run Text="{Binding PageNumber, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" of " />
                        <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>

                    <!-- Next Page -->
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding NextPageCommand}"
                            Padding="8,5" Margin="0,0,4,0"
                            ToolTip="Next Page"
                            AutomationProperties.Name="Next Page Button">
                        <Path Data="{StaticResource IconArrowForward}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource SlateMediumBrush}" VerticalAlignment="Center" />
                    </Button>

                    <!-- Last Page -->
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding LastPageCommand}"
                            Padding="8,5"
                            ToolTip="Last Page"
                            AutomationProperties.Name="Last Page Button">
                        <TextBlock Text="&#187;" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
