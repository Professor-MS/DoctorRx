<UserControl x:Class="DoctorRx.Presentation.Views.ScaffoldedFeatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DoctorRx.Presentation.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ScaffoldedFeatureViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,40" MaxWidth="850" HorizontalAlignment="Left">

            <!-- Phase Badge -->
            <Border Background="{StaticResource PrimaryTealUltraLightBrush}"
                    CornerRadius="6" Padding="12,5" HorizontalAlignment="Left" Margin="0,0,0,12">
                <TextBlock Text="{Binding PhaseMilestone}" 
                           Foreground="{StaticResource PrimaryTealDarkBrush}" 
                           FontWeight="SemiBold" FontSize="12" />
            </Border>

            <!-- Feature Name -->
            <TextBlock Text="{Binding FeatureName}" Style="{StaticResource HeadingLarge}" Margin="0,0,0,8" />

            <!-- Feature Description -->
            <TextBlock Text="{Binding FeatureDescription}" Style="{StaticResource BodyRegular}" 
                       LineHeight="22" Margin="0,0,0,24" />

            <!-- Planned Capabilities Card -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Planned Capabilities in Upcoming Release" 
                               Style="{StaticResource HeadingSmall}" Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding PlannedCapabilities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource SlateBackgroundBrush}" 
                                            CornerRadius="12" Width="22" Height="22">
                                        <TextBlock Text="✓" Foreground="{StaticResource PrimaryTealDarkBrush}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding}" 
                                               Style="{StaticResource BodyRegular}" 
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,20" Background="{StaticResource SlateBorderBrush}" />

                    <!-- Architecture Assurance Note -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="ℹ" FontSize="18" Foreground="{StaticResource InfoSkyBrush}" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" 
                                   Text="Underlying Clean Architecture, Domain entities (Prescriptions, Medicines, Doctors), SQLite database schema, and Application services are already fully generated, wired, and verified in this build." 
                                   Style="{StaticResource BodyMuted}" TextWrapping="Wrap" LineHeight="18" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
