<UserControl x:Class="DoctorRx.Presentation.Views.ScaffoldedFeatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DoctorRx.Presentation.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ScaffoldedFeatureViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,32" MaxWidth="850" HorizontalAlignment="Left">

            <!-- Phase Milestone Badge -->
            <Border Background="{StaticResource PrimaryTealUltraLightBrush}"
                    CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                <TextBlock Text="{Binding PhaseMilestone}" 
                           Foreground="{StaticResource PrimaryTealDarkBrush}" 
                           FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" />
            </Border>

            <!-- Feature Name -->
            <TextBlock Text="{Binding FeatureName}" Style="{StaticResource HeadingLarge}" Margin="0,0,0,6" />

            <!-- Feature Description -->
            <TextBlock Text="{Binding FeatureDescription}" Style="{StaticResource BodyRegular}" 
                       LineHeight="20" Margin="0,0,0,20" />

            <!-- Planned Capabilities Card -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Planned Capabilities in Upcoming Release" 
                               Style="{StaticResource HeadingSmall}" Margin="0,0,0,14" />

                    <ItemsControl ItemsSource="{Binding PlannedCapabilities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Vector Checkmark Icon -->
                                    <Border Grid.Column="0" Background="{StaticResource PrimaryTealUltraLightBrush}" 
                                            CornerRadius="11" Width="22" Height="22">
                                        <Path Data="{StaticResource IconCheck}" Width="11" Height="11" 
                                              Stretch="Uniform" Fill="{StaticResource PrimaryTealDarkBrush}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding}" 
                                               Style="{StaticResource BodyRegular}" 
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,18" Background="{StaticResource SlateBorderBrush}" />

                    <!-- Architecture Assurance Note -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Vector Information Icon -->
                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="{StaticResource PrimaryTealUltraLightBrush}" Margin="0,0,10,0" VerticalAlignment="Top">
                            <Path Data="{StaticResource IconInfo}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource InfoSkyBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Column="1" 
                                   Text="Underlying Clean Architecture, Domain entities (Prescriptions, Medicines, Doctors), SQLite database schema, and Application services are already fully generated, wired, and verified in this build." 
                                   Style="{StaticResource BodyMuted}" TextWrapping="Wrap" LineHeight="18" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
