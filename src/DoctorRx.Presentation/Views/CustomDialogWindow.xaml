<Window x:Class="DoctorRx.Presentation.Views.CustomDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DoctorRx"
        MinWidth="380" MinHeight="180"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource SurfaceWhiteBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <!-- Title & Icon Header -->
            <RowDefinition Height="Auto" />
            <!-- Scrollable Message Body -->
            <RowDefinition Height="*" />
            <!-- Pinned Action Buttons Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Status Icon -->
            <Border x:Name="IconBadge" Grid.Column="0" Width="36" Height="36" CornerRadius="18" 
                    Background="{StaticResource PrimaryTealUltraLightBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                <Path x:Name="IconPath" Data="{StaticResource IconInfo}" Width="18" Height="18" 
                      Stretch="Uniform" Fill="{StaticResource PrimaryTealDarkBrush}" 
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Title -->
            <TextBlock x:Name="TitleTextBlock" Grid.Column="1" Text="Notification" 
                       Style="{StaticResource HeadingSmall}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Scrollable Message Content -->
        <ScrollViewer Grid.Row="1" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <TextBlock x:Name="MessageTextBlock" Text="Dialog message text." 
                       Style="{StaticResource BodyRegular}" 
                       Foreground="{StaticResource SlateDarkBrush}"
                       TextWrapping="Wrap" LineHeight="20" />
        </ScrollViewer>

        <!-- Action Buttons Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Cancel / Close Button (Used in ConfirmationWithCancel) -->
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}" 
                    IsCancel="True" Click="OnCancelClicked" 
                    Padding="16,8" Margin="0,0,8,0" Visibility="Collapsed"
                    AutomationProperties.Name="Cancel Dialog Button" />

            <!-- Secondary Button (No) -->
            <Button x:Name="SecondaryButton" Content="No" Style="{StaticResource SecondaryButton}" 
                    Click="OnSecondaryClicked" 
                    Padding="16,8" Margin="0,0,8,0" Visibility="Collapsed"
                    AutomationProperties.Name="Secondary Dialog Button" />

            <!-- Primary Button (OK / Yes) -->
            <Button x:Name="PrimaryButton" Content="OK" Style="{StaticResource PrimaryButton}" 
                    IsDefault="True" Click="OnPrimaryClicked" 
                    Padding="20,8"
                    AutomationProperties.Name="Primary Dialog Button" />
        </StackPanel>
    </Grid>
</Window>
