<UserControl x:Class="DoctorRx.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DoctorRx.Presentation.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="850" d:DesignWidth="1100"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,36">

            <!-- Top Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Settings &amp; Maintenance" Style="{StaticResource HeadingLarge}" />
                    <TextBlock Text="Database protection, automated backup schedules, clinic configuration, and system integrity." 
                               Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Status indicator when busy -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsRunningBackup, Converter={StaticResource BoolToVisConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="6" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OperationStatusMessage}" Style="{StaticResource CaptionMuted}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Navigation Tabs -->
            <Border Background="White" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Database &amp; Backups" IsChecked="True" 
                                 Style="{StaticResource SegmentTabRadioButton}"
                                 Padding="16,10" FontWeight="SemiBold"
                                 AutomationProperties.Name="Database and Backups Tab" />
                    <RadioButton Content="Doctor Profile" IsChecked="False" IsEnabled="False"
                                 Style="{StaticResource SegmentTabRadioButton}"
                                 Padding="16,10" FontWeight="SemiBold" ToolTip="Doctor Profile settings available in next update"
                                 AutomationProperties.Name="Doctor Profile Tab" />
                    <RadioButton Content="Clinic Branding" IsChecked="False" IsEnabled="False"
                                 Style="{StaticResource SegmentTabRadioButton}"
                                 Padding="16,10" FontWeight="SemiBold" ToolTip="Clinic Branding settings available in next update"
                                 AutomationProperties.Name="Clinic Branding Tab" />
                    <RadioButton Content="Prescription Layout" IsChecked="False" IsEnabled="False"
                                 Style="{StaticResource SegmentTabRadioButton}"
                                 Padding="16,10" FontWeight="SemiBold" ToolTip="Layout and paper dimensions available in next update"
                                 AutomationProperties.Name="Prescription Layout Tab" />
                </StackPanel>
            </Border>

            <!-- SECTION 1: Database Health & Integrity Card -->
            <Border Style="{StaticResource CardContainer}" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDatabase}" Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource PrimaryTealBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Database Health &amp; Storage" FontWeight="Bold" FontSize="{StaticResource FontSizeH3}" Foreground="{StaticResource SlateDarkestBrush}" VerticalAlignment="Center" />
                            <Border Background="{Binding HealthBadgeColor}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HealthSummary}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RunFullIntegrityCheckCommand}"
                                IsEnabled="{Binding IsRunningHealthCheck, Converter={StaticResource InverseBoolConverter}}"
                                Padding="12,6"
                                ToolTip="Run SQLite PRAGMA integrity_check and search index token validation"
                                AutomationProperties.Name="Run Full Integrity Check Button">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconShield}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource SlateDarkBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Run Integrity Check" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Separator Background="{StaticResource SlateBorderBrush}" Margin="0,0,0,16" />

                    <!-- Metrics Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="DATABASE FILE LOCATION" Style="{StaticResource CaptionMuted}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DatabasePath}" Foreground="{StaticResource SlateDarkBrush}" FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="DATABASE SIZE" Style="{StaticResource CaptionMuted}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DatabaseSizeText}" Foreground="{StaticResource SlateDarkestBrush}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DRIVE FREE SPACE" Style="{StaticResource CaptionMuted}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FreeSpaceText}" Foreground="{StaticResource SlateDarkestBrush}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 2: Manual Backup & Restore Action Bar -->
            <Border Style="{StaticResource CardContainer}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Manual Backup &amp; Restore" FontWeight="Bold" FontSize="{StaticResource FontSizeH3}" Foreground="{StaticResource SlateDarkestBrush}" />
                        <TextBlock Text="Create a verified snapshot container (.drxbackup) or restore an external backup file." Style="{StaticResource BodyMuted}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" 
                                Command="{Binding BackupNowCommand}"
                                IsEnabled="{Binding IsRunningBackup, Converter={StaticResource InverseBoolConverter}}"
                                Padding="16,8" Margin="0,0,10,0"
                                ToolTip="Create a full verified database backup now"
                                AutomationProperties.Name="Back Up Now Button">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Back Up Now" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButton}" 
                                Command="{Binding RestoreFromFileCommand}"
                                IsEnabled="{Binding IsRunningRestore, Converter={StaticResource InverseBoolConverter}}"
                                Padding="14,8" Margin="0,0,10,0"
                                ToolTip="Select an external .drxbackup file from disk to restore"
                                AutomationProperties.Name="Restore From File Button">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource SlateDarkBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Restore from File..." VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GhostButton}" 
                                Command="{Binding OpenFolderCommand}"
                                CommandParameter="{Binding BackupsDirectory}"
                                Padding="10,8"
                                ToolTip="Open the backups folder in Windows Explorer"
                                AutomationProperties.Name="Open Backups Folder Button">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource SlateMediumBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Open Backups Folder" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SECTION 3: Available Backups Table -->
            <Border Style="{StaticResource CardContainer}" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconArchive}" Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource SlateDarkBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Available Backup Archives" FontWeight="Bold" FontSize="{StaticResource FontSizeH3}" Foreground="{StaticResource SlateDarkestBrush}" VerticalAlignment="Center" />
                            <Border Background="#F1F5F9" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Backups.Count, StringFormat='{}{0} archives'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SlateDarkBrush}" />
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" 
                                Command="{Binding RefreshBackupsCommand}"
                                Padding="8,4"
                                ToolTip="Refresh Backups List"
                                AutomationProperties.Name="Refresh Backups List Button">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource SlateMediumBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Refresh" FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Separator Background="{StaticResource SlateBorderBrush}" Margin="0,0,0,12" />

                    <!-- Backup Items List -->
                    <ItemsControl ItemsSource="{Binding Backups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" MinWidth="180" />
                                            <ColumnDefinition Width="2*" MinWidth="140" />
                                            <ColumnDefinition Width="*" MinWidth="90" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Name & Verification Badge -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{StaticResource SlateDarkestBrush}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="6,1"
                                                        Visibility="{Binding IsVerified, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="Verified Archive" FontSize="10" FontWeight="SemiBold" Foreground="#059669" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Date -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding CreatedAtUtc, StringFormat='{}{0:yyyy-MM-dd h:mm tt}'}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource SlateDarkBrush}" />
                                            <TextBlock Text="UTC Timestamp" FontSize="10" Foreground="{StaticResource SlateLightBrush}" />
                                        </StackPanel>

                                        <!-- Size -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding FileSizeBytes, Converter={StaticResource FileSizeConverter}}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{StaticResource SlateDarkBrush}" />
                                            <TextBlock Text="ZIP Container" FontSize="10" Foreground="{StaticResource SlateLightBrush}" />
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Verify"
                                                    Command="{Binding DataContext.VerifyBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0"
                                                    ToolTip="Verify archive checksum, manifest, and table row counts"
                                                    AutomationProperties.Name="Verify Backup Button" />

                                            <Button Content="Restore..."
                                                    Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerOutlineButton}" Padding="10,4"
                                                    ToolTip="Restore database from this backup (creates safety copy first)"
                                                    AutomationProperties.Name="Restore Backup Button" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No backups found in the configured destination folder." 
                               Style="{StaticResource CaptionMuted}" HorizontalAlignment="Center" Margin="0,16,0,8"
                               Visibility="{Binding Backups.Count, Converter={StaticResource CountToZeroVisConverter}}" />
                </StackPanel>
            </Border>

            <!-- SECTION 4: Automatic Backup & Retention Settings -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Automatic Backup &amp; Retention Policies" FontWeight="Bold" FontSize="{StaticResource FontSizeH3}" Foreground="{StaticResource SlateDarkestBrush}" />
                    <TextBlock Text="Configure scheduled protection triggers and the Grandfather-Father-Son (GFS) retention window." Style="{StaticResource BodyMuted}" Margin="0,2,0,16" />

                    <Separator Background="{StaticResource SlateBorderBrush}" Margin="0,0,0,16" />

                    <!-- Schedule Toggles -->
                    <StackPanel Margin="0,0,0,16">
                        <CheckBox Content="Create automatic backup on application shutdown" 
                                  IsChecked="{Binding AutoBackupOnShutdown}"
                                  FontWeight="SemiBold" Margin="0,0,0,10"
                                  AutomationProperties.Name="Backup On Shutdown Checkbox" />

                        <CheckBox Content="Create automatic daily backup on first startup each day" 
                                  IsChecked="{Binding AutoBackupDaily}"
                                  FontWeight="SemiBold"
                                  AutomationProperties.Name="Daily Backup Checkbox" />
                    </StackPanel>

                    <!-- Destination Directory -->
                    <TextBlock Text="CUSTOM BACKUP DESTINATION (OPTIONAL)" Style="{StaticResource CaptionMuted}" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding CustomBackupDestination, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Padding="10,7" Margin="0,0,10,0"
                                 AutomationProperties.Name="Custom Backup Destination Input" />

                        <Button Grid.Column="1" Content="Browse Folder..."
                                Command="{Binding BrowseFolderCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="12,7"
                                AutomationProperties.Name="Browse Backup Folder Button" />
                    </Grid>

                    <!-- Same Drive Warning -->
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                            Visibility="{Binding IsDestinationOnSameDrive, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconWarning}" Width="16" Height="16" Stretch="Uniform" Fill="#D97706" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Recommendation: Storing backups on an external drive or secondary storage protects your records if your primary drive fails."
                                       FontSize="{StaticResource FontSizeCaption}" Foreground="#92400E" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Retention Counts -->
                    <TextBlock Text="RETENTION POLICY (MAX BACKUPS TO KEEP)" Style="{StaticResource CaptionMuted}" FontWeight="SemiBold" Margin="0,8,0,8" />
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Daily Backups" Style="{StaticResource CaptionMuted}" />
                            <TextBox Text="{Binding KeepDailyCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,4,0,0" Width="100" HorizontalAlignment="Left" />
                            <TextBlock Text="Default: 7 daily copies" FontSize="10" Foreground="{StaticResource SlateLightBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Weekly Backups" Style="{StaticResource CaptionMuted}" />
                            <TextBox Text="{Binding KeepWeeklyCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,4,0,0" Width="100" HorizontalAlignment="Left" />
                            <TextBlock Text="Default: 4 weekly copies" FontSize="10" Foreground="{StaticResource SlateLightBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Monthly Backups" Style="{StaticResource CaptionMuted}" />
                            <TextBox Text="{Binding KeepMonthlyCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,4,0,0" Width="100" HorizontalAlignment="Left" />
                            <TextBlock Text="Default: 3 monthly copies" FontSize="10" Foreground="{StaticResource SlateLightBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Button Style="{StaticResource PrimaryButton}" 
                            Command="{Binding SaveBackupSettingsCommand}"
                            HorizontalAlignment="Left" Padding="20,8"
                            AutomationProperties.Name="Save Backup Settings Button">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheck}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Save Backup Preferences" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
