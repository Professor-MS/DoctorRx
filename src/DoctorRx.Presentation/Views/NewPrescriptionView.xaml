<UserControl x:Class="DoctorRx.Presentation.Views.NewPrescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DoctorRx.Presentation.ViewModels"
             xmlns:behaviors="clr-namespace:DoctorRx.Presentation.Behaviors"
             xmlns:domainEnums="clr-namespace:DoctorRx.Domain.Enums;assembly=DoctorRx.Domain"
             xmlns:appEnums="clr-namespace:DoctorRx.Application.DTOs;assembly=DoctorRx.Application"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1100"
             Background="{StaticResource SlateBackgroundBrush}"
             AutomationProperties.Name="New Prescription Composer Screen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Command & Status Bar -->
            <RowDefinition Height="Auto" />
            <!-- Undo Toast Banner -->
            <RowDefinition Height="Auto" />
            <!-- Main Scrollable Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= TOP TOOLBAR ================= -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceWhiteBrush}" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScreenTitle}" Style="{StaticResource HeadingLarge}" Margin="0,0,16,0" />
                    <!-- Autosave Indicator -->
                    <Border Background="{StaticResource PrimaryTealUltraLightBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource PrimaryTealDarkBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding LastSavedText}" Style="{StaticResource BodyMuted}" Foreground="{StaticResource PrimaryTealDarkBrush}" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Discard Draft" Command="{Binding CancelOrDiscardCommand}" Style="{StaticResource DangerOutlineButton}" Margin="0,0,10,0" AutomationProperties.Name="Discard Draft Button" />
                    <Button Content="Save Draft (Ctrl+S)" Command="{Binding SaveDraftExplicitCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" AutomationProperties.Name="Save Draft Button" />
                    <Button Content="Finalize Prescription" Command="{Binding FinalizePrescriptionCommand}" Style="{StaticResource PrimaryButton}" FontWeight="SemiBold" Padding="20,10" AutomationProperties.Name="Finalize Prescription Button" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= UNDO TOAST BANNER ================= -->
        <Border Grid.Row="1" Background="#0F172A" Padding="16,10" Visibility="{Binding IsUndoAvailable, Converter={StaticResource BoolToVisConverter}}">
            <Grid MaxWidth="1000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding UndoBannerText}" Foreground="White" FontWeight="Medium" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Undo" Command="{Binding UndoDeleteMedicineCommand}" Style="{StaticResource PrimaryButton}" Background="{StaticResource PrimaryTealLightBrush}" Padding="14,4" />
            </Grid>
        </Border>

        <!-- ================= MAIN SCROLLABLE CONTENT ================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,18">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

                <!-- 1. PATIENT SELECTION & CARD -->
                <Border Style="{StaticResource CardContainer}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Patient Information" Style="{StaticResource HeadingMedium}" />
                            <Button Content="Change Patient" Command="{Binding ChangePatientCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                    Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolToVisConverter}}" AutomationProperties.Name="Change Patient Button" />
                        </Grid>

                        <!-- If No Patient Selected: Search & Quick Register -->
                        <StackPanel Visibility="{Binding HasSelectedPatient, Converter={StaticResource InverseBoolToVisConverter}}">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PatientSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource SearchBox}" 
                                         Tag="Search by patient name, MR number, or phone..." 
                                         AutomationProperties.Name="Patient Search Box" />
                                <Button Grid.Column="1" Content="+ Register New Patient" Command="{Binding OpenQuickRegisterDrawerCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" AutomationProperties.Name="Open Register Patient Button" />
                            </Grid>

                            <!-- Live Search Suggestions -->
                            <ListBox ItemsSource="{Binding PatientSearchResults}" MaxHeight="180" Background="{StaticResource SlateBackgroundBrush}" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1"
                                     Visibility="{Binding PatientSearchResults.Count, Converter={StaticResource BoolToVisConverter}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,6" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RecordNumber}" FontWeight="Bold" Foreground="{StaticResource PrimaryTealDarkBrush}" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource SlateDarkestBrush}" />
                                                <Button Grid.Column="2" Content="Select" Command="{Binding DataContext.SelectPatientCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Padding="10,3" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Quick Register Drawer -->
                            <Border Background="{StaticResource SlateBackgroundBrush}" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,10,0,0"
                                    Visibility="{Binding IsQuickRegisterDrawerOpen, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Quick Patient Registration" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewPatientName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Full Name *" Margin="0,0,8,0" AutomationProperties.Name="New Patient Name" />
                                        <TextBox Grid.Column="1" Text="{Binding NewPatientAge, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Age (Years) *" Margin="0,0,8,0" AutomationProperties.Name="New Patient Age" />
                                        <ComboBox Grid.Column="2" SelectedItem="{Binding NewPatientGender}" Margin="0,0,8,0" VerticalContentAlignment="Center">
                                            <domainEnums:Gender>Male</domainEnums:Gender>
                                            <domainEnums:Gender>Female</domainEnums:Gender>
                                            <domainEnums:Gender>Other</domainEnums:Gender>
                                        </ComboBox>
                                        <TextBox Grid.Column="3" Text="{Binding NewPatientPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Phone (Optional)" AutomationProperties.Name="New Patient Phone" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Cancel" Command="{Binding CloseQuickRegisterDrawerCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                        <Button Content="Save &amp; Select Patient" Command="{Binding SaveQuickRegisterPatientCommand}" Style="{StaticResource PrimaryButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Selected Patient Summary Card -->
                        <Border Background="{StaticResource SlateBackgroundBrush}" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16"
                                Visibility="{Binding HasSelectedPatient, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedPatient.Name}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SlateDarkestBrush}" Margin="0,0,12,0" />
                                        <Border Background="{StaticResource PrimaryTealUltraLightBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedPatient.RecordNumber}" FontWeight="Bold" Foreground="{StaticResource PrimaryTealDarkBrush}" FontSize="12" />
                                        </Border>
                                        <TextBlock Text="{Binding SelectedPatient.AgeText}" Foreground="{StaticResource SlateMediumBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="•" Foreground="{StaticResource SlateLightBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SelectedPatient.Gender}" Foreground="{StaticResource SlateMediumBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="•" Foreground="{StaticResource SlateLightBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SelectedPatient.Phone}" Foreground="{StaticResource SlateMediumBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPatient.LastVisitDate, StringFormat='Last Visit: {0:dd MMM yyyy}'}" Style="{StaticResource BodyMuted}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Allergies Alert Banner (Soft Red) -->
                                <Border Background="{StaticResource DangerRedLightBrush}" BorderBrush="{StaticResource DangerRedBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,10,0,0"
                                        Visibility="{Binding HasAllergiesAlert, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠ KNOWN ALLERGIES: " FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}" FontSize="12.5" />
                                        <TextBlock Text="{Binding SelectedPatient.KnownAllergies}" FontWeight="SemiBold" Foreground="{StaticResource DangerRedBrush}" FontSize="12.5" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. CLINICAL OBSERVATIONS (VITALS & NOTES) -->
                <Border Style="{StaticResource CardContainer}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Clinical Observations &amp; Vitals" Style="{StaticResource HeadingSmall}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ChiefComplaints, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Chief Complaints" Margin="0,0,8,0" AutomationProperties.Name="Chief Complaints" />
                            <TextBox Grid.Column="1" Text="{Binding BloodPressure, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="BP (mmHg)" Margin="0,0,8,0" AutomationProperties.Name="Blood Pressure" />
                            <TextBox Grid.Column="2" Text="{Binding PulseRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Pulse (bpm)" Margin="0,0,8,0" AutomationProperties.Name="Pulse Rate" />
                            <TextBox Grid.Column="3" Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Temp (°F)" Margin="0,0,8,0" AutomationProperties.Name="Temperature" />
                            <TextBox Grid.Column="4" Text="{Binding WeightKg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Weight (kg)" AutomationProperties.Name="Weight" />
                        </Grid>
                        <TextBox Text="{Binding ClinicalNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Clinical Examination &amp; Diagnostic Notes (Optional)" Height="50" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Clinical Notes" />
                    </StackPanel>
                </Border>

                <!-- 3. PRESCRIBED MEDICINES & INLINE EDITOR -->
                <Border Style="{StaticResource CardContainer}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Rx Prescribed Medicines" Style="{StaticResource HeadingMedium}" Margin="0,0,0,12" />

                        <!-- INLINE MEDICINE EDITOR (Zero Clinical Defaults) -->
                        <Border Background="#F1F5F9" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="{Binding EditorHeaderTitle}" FontWeight="SemiBold" Foreground="{StaticResource SlateDarkestBrush}" />
                                    <Button Content="Cancel Edit" Command="{Binding CancelEditMedicineCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                            Visibility="{Binding IsEditingMedicine, Converter={StaticResource BoolToVisConverter}}" Padding="10,2" />
                                </Grid>

                                <!-- Row 1: Search / Medicine Name, Form, Strength, Generic -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.5*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBox Text="{Binding MedicineSearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Search Formulary / Enter Medicine Name *" AutomationProperties.Name="Medicine Name Input" />
                                        <!-- Autocomplete Results -->
                                        <ListBox ItemsSource="{Binding MedicineSearchResults}" MaxHeight="140" Margin="0,2,0,0"
                                                 Visibility="{Binding MedicineSearchResults.Count, Converter={StaticResource BoolToVisConverter}}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="6,4" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding GenericName, StringFormat=' ({0})'}" Foreground="{StaticResource SlateMutedBrush}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Pick" Command="{Binding DataContext.SelectCatalogMedicineCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,2" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding Form, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Form (e.g. Tab)" Margin="0,0,8,0" AutomationProperties.Name="Medicine Form" />
                                    <TextBox Grid.Column="2" Text="{Binding Strength, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Strength (e.g. 500mg)" Margin="0,0,8,0" AutomationProperties.Name="Medicine Strength" />
                                    <TextBox Grid.Column="3" Text="{Binding GenericName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Generic Formulation" AutomationProperties.Name="Medicine Generic Name" />
                                </Grid>

                                <!-- Row 2: Dose, Frequency, Duration, Route -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Dose with Chips -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBox Text="{Binding Dose, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Dose * (e.g. 1 tab)" AutomationProperties.Name="Dose Input" />
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="1/2 tab" Command="{Binding SelectDoseChipCommand}" CommandParameter="1/2 tab" Style="{StaticResource SecondaryButton}" Padding="4,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="1 tab" Command="{Binding SelectDoseChipCommand}" CommandParameter="1 tab" Style="{StaticResource SecondaryButton}" Padding="4,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="2 tabs" Command="{Binding SelectDoseChipCommand}" CommandParameter="2 tabs" Style="{StaticResource SecondaryButton}" Padding="4,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="5 ml" Command="{Binding SelectDoseChipCommand}" CommandParameter="5 ml" Style="{StaticResource SecondaryButton}" Padding="4,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="10 ml" Command="{Binding SelectDoseChipCommand}" CommandParameter="10 ml" Style="{StaticResource SecondaryButton}" Padding="4,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="1 drop" Command="{Binding SelectDoseChipCommand}" CommandParameter="1 drop" Style="{StaticResource SecondaryButton}" Padding="4,1" Margin="0,0,4,4" FontSize="11" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Frequency with Chips -->
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBox Text="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Frequency * (e.g. TDS)" AutomationProperties.Name="Frequency Input" />
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="OD" Command="{Binding SelectFrequencyChipCommand}" CommandParameter="OD" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="BD" Command="{Binding SelectFrequencyChipCommand}" CommandParameter="BD" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="TDS" Command="{Binding SelectFrequencyChipCommand}" CommandParameter="TDS" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="QID" Command="{Binding SelectFrequencyChipCommand}" CommandParameter="QID" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="SOS" Command="{Binding SelectFrequencyChipCommand}" CommandParameter="SOS" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="PRN" Command="{Binding SelectFrequencyChipCommand}" CommandParameter="PRN" Style="{StaticResource SecondaryButton}" Padding="5,1" Margin="0,0,4,4" FontSize="11" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Duration with Chips -->
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Duration (e.g. 5 days)" AutomationProperties.Name="Duration Input" />
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="3 days" Command="{Binding SelectDurationChipCommand}" CommandParameter="3 days" Style="{StaticResource SecondaryButton}" Padding="4,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="5 days" Command="{Binding SelectDurationChipCommand}" CommandParameter="5 days" Style="{StaticResource SecondaryButton}" Padding="4,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="7 days" Command="{Binding SelectDurationChipCommand}" CommandParameter="7 days" Style="{StaticResource SecondaryButton}" Padding="4,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="14 days" Command="{Binding SelectDurationChipCommand}" CommandParameter="14 days" Style="{StaticResource SecondaryButton}" Padding="4,1" Margin="0,0,4,4" FontSize="11" />
                                            <Button Content="1 month" Command="{Binding SelectDurationChipCommand}" CommandParameter="1 month" Style="{StaticResource SecondaryButton}" Padding="4,1" Margin="0,0,4,4" FontSize="11" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Route & Meal Relation -->
                                    <StackPanel Grid.Column="3">
                                        <TextBox Text="{Binding Route, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Tag="Route (e.g. Oral)" Margin="0,0,0,6" AutomationProperties.Name="Route Input" />
                                        <ComboBox SelectedItem="{Binding MealRelation}" Height="34" VerticalContentAlignment="Center">
                                            <domainEnums:MealRelation>AsDirected</domainEnums:MealRelation>
                                            <domainEnums:MealRelation>BeforeMeal</domainEnums:MealRelation>
                                            <domainEnums:MealRelation>AfterMeal</domainEnums:MealRelation>
                                            <domainEnums:MealRelation>WithMeal</domainEnums:MealRelation>
                                            <domainEnums:MealRelation>EmptyStomach</domainEnums:MealRelation>
                                            <domainEnums:MealRelation>Bedtime</domainEnums:MealRelation>
                                            <domainEnums:MealRelation>Other</domainEnums:MealRelation>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 3: Special Instructions (Urdu/English Auto-Direction) & Add to Catalog checkbox -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource SearchBox}" 
                                             Tag="Special Instructions / ہدایات (Auto RTL for Urdu / LTR for English)" 
                                             behaviors:AutoFlowDirection.IsEnabled="True"
                                             Margin="0,0,12,0" 
                                             AutomationProperties.Name="Special Instructions Input" />
                                    <CheckBox Grid.Column="1" Content="Add to clinic formulary catalog" IsChecked="{Binding AddToCatalog}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Row 4: Submit Button -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{Binding AddOrUpdateMedicineButtonText}" Command="{Binding AddOrUpdateMedicineCommand}" Style="{StaticResource PrimaryButton}" Padding="20,8" AutomationProperties.Name="Add Medicine Button" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- PRESCRIBED MEDICINES NUMBERED LIST -->
                        <ItemsControl ItemsSource="{Binding PrescribedMedicines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceWhiteBrush}" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Bullet / Line Number -->
                                            <Border Grid.Column="0" Background="{StaticResource PrimaryTealUltraLightBrush}" CornerRadius="12" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Rx" FontWeight="Bold" Foreground="{StaticResource PrimaryTealDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                            </Border>

                                            <!-- Medicine Line Content -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Form}" FontWeight="Bold" Foreground="{StaticResource PrimaryTealDarkBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding MedicineName}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SlateDarkestBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Strength}" FontWeight="SemiBold" Foreground="{StaticResource SlateMediumBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding GenericName, StringFormat='({0})'}" Foreground="{StaticResource SlateMutedBrush}" FontSize="12.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <!-- Plain-language directions -->
                                                <TextBlock Text="{Binding FormattedDirections}" FontWeight="Medium" Foreground="{StaticResource SlateDarkBrush}" Margin="0,3,0,0" />
                                                <!-- Special Instructions if present -->
                                                <TextBlock Text="{Binding Instructions}" Foreground="{StaticResource PrimaryTealDarkBrush}" FontSize="12.5" Margin="0,2,0,0"
                                                           behaviors:AutoFlowDirection.IsEnabled="True"
                                                           Visibility="{Binding Instructions, Converter={StaticResource BoolToVisConverter}}" />
                                            </StackPanel>

                                            <!-- Actions: Edit, Move Up, Move Down, Delete -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="▲" Command="{Binding DataContext.MoveUpMedicineRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="0,0,4,0" ToolTip="Move Up" />
                                                <Button Content="▼" Command="{Binding DataContext.MoveDownMedicineRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="0,0,6,0" ToolTip="Move Down" />
                                                <Button Content="Edit" Command="{Binding DataContext.EditMedicineRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0" />
                                                <Button Content="Delete" Command="{Binding DataContext.DeleteMedicineRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerOutlineButton}" Padding="10,4" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state when no medicines yet -->
                        <Border Background="{StaticResource SlateBackgroundBrush}" CornerRadius="8" Padding="30" Margin="0,4,0,0"
                                Visibility="{Binding PrescribedMedicines.Count, Converter={StaticResource InverseBoolToVisConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No medicines prescribed yet." FontWeight="SemiBold" Foreground="{StaticResource SlateMutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Use the editor above to prescribe medicines from formulary catalog or custom entries." Style="{StaticResource BodyMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. ADVICE & FOLLOW-UP -->
                <Border Style="{StaticResource CardContainer}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="General Advice &amp; Follow-up" Style="{StaticResource HeadingSmall}" Margin="0,0,0,12" />

                        <!-- Advice Text Box with AutoFlowDirection -->
                        <TextBox Text="{Binding GeneralAdvice, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource SearchBox}" 
                                 Tag="General advice, dietary instructions, precautions (Urdu/English auto-aligned)..." 
                                 Height="80" TextWrapping="Wrap" AcceptsReturn="True" 
                                 behaviors:AutoFlowDirection.IsEnabled="True"
                                 AutomationProperties.Name="General Advice Input"
                                 Margin="0,0,0,8" />

                        <!-- Bilingual Advice Presets -->
                        <WrapPanel Margin="0,0,0,14">
                            <TextBlock Text="Common Presets: " Foreground="{StaticResource SlateMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,4" FontSize="12" />
                            <Button Content="پانی کا زیادہ استعمال کریں" Command="{Binding AddAdvicePresetCommand}" CommandParameter="پانی کا زیادہ استعمال کریں (Drink plenty of fluids)" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="0,0,4,4" FontSize="11" />
                            <Button Content="مرچ اور تلی اشیاء سے پرہیز" Command="{Binding AddAdvicePresetCommand}" CommandParameter="مرچ اور تلی ہوئی اشیاء سے پرہیز کریں (Avoid spicy and oily food)" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="0,0,4,4" FontSize="11" />
                            <Button Content="مکمل آرام کریں" Command="{Binding AddAdvicePresetCommand}" CommandParameter="مکمل آرام کریں (Adequate bed rest)" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="0,0,4,4" FontSize="11" />
                            <Button Content="مکمل کورس کریں" Command="{Binding AddAdvicePresetCommand}" CommandParameter="ادویات کا مکمل کورس کریں (Complete full course of medication)" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="0,0,4,4" FontSize="11" />
                            <Button Content="ایمرجنسی میں فوری رجوع" Command="{Binding AddAdvicePresetCommand}" CommandParameter="طبیعت خراب ہونے پر فوری رجوع کریں (Return immediately in case of emergency)" Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="0,0,4,4" FontSize="11" />
                        </WrapPanel>

                        <!-- Follow-up Configuration & Preview -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" SelectedItem="{Binding FollowUpMode}" Height="34" VerticalContentAlignment="Center" Margin="0,0,8,0">
                                <appEnums:FollowUpMode>None</appEnums:FollowUpMode>
                                <appEnums:FollowUpMode>InDays</appEnums:FollowUpMode>
                                <appEnums:FollowUpMode>InWeeks</appEnums:FollowUpMode>
                                <appEnums:FollowUpMode>InMonths</appEnums:FollowUpMode>
                                <appEnums:FollowUpMode>SOS</appEnums:FollowUpMode>
                                <appEnums:FollowUpMode>PRN</appEnums:FollowUpMode>
                            </ComboBox>
                            <TextBox Grid.Column="1" Text="{Binding FollowUpInterval, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource SearchBox}" 
                                     Visibility="{Binding IsIntervalFollowUp, Converter={StaticResource BoolToVisConverter}}" 
                                     Tag="Days" Margin="0,0,12,0" AutomationProperties.Name="Follow Up Interval" />
                            <Border Grid.Column="2" Background="{StaticResource SlateBackgroundBrush}" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Follow-up note: " Foreground="{StaticResource SlateMutedBrush}" FontWeight="Medium" />
                                    <TextBlock Text="{Binding FollowUpPreviewText}" FontWeight="Bold" Foreground="{StaticResource PrimaryTealDarkBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- VALIDATION ALERTS (IF ANY) -->
                <Border Background="{StaticResource DangerRedLightBrush}" BorderBrush="{StaticResource DangerRedBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding ValidationErrorMessage}" Foreground="{StaticResource DangerRedBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <!-- BOTTOM FINALIZE BAR -->
                <Border Background="{StaticResource SurfaceWhiteBrush}" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ready to Issue Prescription" FontWeight="Bold" FontSize="15" Foreground="{StaticResource SlateDarkestBrush}" />
                            <TextBlock Text="Finalization freezes clinical snapshots, assigns sequential prescription number, and deletes draft." Style="{StaticResource BodyMuted}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Finalize Prescription" Command="{Binding FinalizePrescriptionCommand}" Style="{StaticResource PrimaryButton}" Padding="28,12" FontSize="15" FontWeight="Bold" AutomationProperties.Name="Finalize Prescription Bottom Button" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
