<UserControl x:Class="DoctorRx.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DoctorRx.Presentation.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,36">

            <!-- Top Banner / Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Welcome back to DoctorRx" Style="{StaticResource HeadingLarge}" />
                    <TextBlock Text="Local clinic workstation • Ready for prescriptions and patient records" 
                               Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" 
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,10,0" Padding="12,8"
                            ToolTip="Refresh Dashboard Data"
                            AutomationProperties.Name="Refresh Dashboard Data">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource SlateMediumBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryButton}" 
                            Command="{Binding NewPrescriptionCommand}"
                            Padding="16,8"
                            ToolTip="Create New Prescription"
                            AutomationProperties.Name="Create New Prescription">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="New Prescription" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Active Drafts Recovery Banner -->
            <Border Visibility="{Binding HasActiveDrafts, Converter={StaticResource BoolToVisConverter}}"
                    Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconWarning}" Width="16" Height="16" Stretch="Uniform" Fill="#D97706" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="In-Progress Prescription Drafts" FontWeight="Bold" FontSize="{StaticResource FontSizeH3}" Foreground="#92400E" VerticalAlignment="Center" />
                            <Border Background="#FDE68A" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveDraftsCount, StringFormat='{}{0} saved'}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="#92400E" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ActiveDrafts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="140" />
                                            <ColumnDefinition Width="*" MinWidth="110" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayPatientName}" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MedicineCount, StringFormat='{}{0} medicines prescribed'}" FontSize="{StaticResource FontSizeCaption}" Foreground="#64748B" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding RelativeTimeText}" FontSize="{StaticResource FontSizeCaption}" Foreground="#64748B" />
                                            <TextBlock Text="Older than 30 days" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" Foreground="#DC2626"
                                                       Visibility="{Binding IsOlderThan30Days, Converter={StaticResource BoolToVisConverter}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Resume Draft" 
                                                    Command="{Binding DataContext.ResumeDraftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                    CommandParameter="{Binding}" 
                                                    Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="0,0,6,0"
                                                    AutomationProperties.Name="Resume Prescription Draft" />
                                            <Button Content="Discard" 
                                                    Command="{Binding DataContext.DiscardDraftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                    CommandParameter="{Binding}" 
                                                    Style="{StaticResource SecondaryButton}" Padding="10,4"
                                                    AutomationProperties.Name="Discard Prescription Draft" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 4 Metric Stat Cards (Responsive UniformGrid: 4 in Wide, 2 in Normal/Compact, 1 in Narrow) -->
            <UniformGrid Columns="{Binding StatCardColumns}" Margin="-6,0,-6,20">
                <!-- Metric 1: Total Patients -->
                <Border Style="{StaticResource StatCard}" Margin="6" MinWidth="200">
                    <StackPanel>
                        <TextBlock Text="TOTAL PATIENTS" Style="{StaticResource CaptionMuted}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalPatients}" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource SlateDarkestBrush}" Margin="0,4,0,2" />
                        <TextBlock Text="Registered in local database" Style="{StaticResource CaptionMuted}" />
                    </StackPanel>
                </Border>

                <!-- Metric 2: Prescriptions Today -->
                <Border Style="{StaticResource StatCard}" Margin="6" MinWidth="200">
                    <StackPanel>
                        <TextBlock Text="PRESCRIPTIONS TODAY" Style="{StaticResource CaptionMuted}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PrescriptionsToday}" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryTealDarkBrush}" Margin="0,4,0,2" />
                        <TextBlock Text="Issued today" Style="{StaticResource CaptionMuted}" />
                    </StackPanel>
                </Border>

                <!-- Metric 3: Total Prescriptions -->
                <Border Style="{StaticResource StatCard}" Margin="6" MinWidth="200">
                    <StackPanel>
                        <TextBlock Text="ALL-TIME PRESCRIPTIONS" Style="{StaticResource CaptionMuted}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalPrescriptions}" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource SlateDarkestBrush}" Margin="0,4,0,2" />
                        <TextBlock Text="Preserved in history" Style="{StaticResource CaptionMuted}" />
                    </StackPanel>
                </Border>

                <!-- Metric 4: Medicines in Catalog -->
                <Border Style="{StaticResource StatCard}" Margin="6" MinWidth="200">
                    <StackPanel>
                        <TextBlock Text="CATALOG MEDICINES" Style="{StaticResource CaptionMuted}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalMedicinesInCatalog}" FontSize="28" FontWeight="Bold" 
                                   Foreground="{StaticResource SlateDarkestBrush}" Margin="0,4,0,2" />
                        <TextBlock Text="Available formulations" Style="{StaticResource CaptionMuted}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Database Backup & Health Status Bar -->
            <Border Background="White" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Shield / Backup Icon -->
                        <Border Background="#F1F5F9" CornerRadius="18" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconShield}" Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource PrimaryTealBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Database Backup Status" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource SlateDarkestBrush}" VerticalAlignment="Center" />
                                <Border Background="{Binding BackupBadgeBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BackupBadgeText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding LastBackupText}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource SlateMediumBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" 
                                Command="{Binding BackupNowDashboardCommand}"
                                IsEnabled="{Binding IsBackingUp, Converter={StaticResource InverseBoolConverter}}"
                                Padding="12,6" Margin="0,0,8,0"
                                ToolTip="Perform immediate database backup"
                                AutomationProperties.Name="Back Up Database Now Button">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource SlateDarkBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Back Up Now" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GhostButton}" 
                                Command="{Binding NavigateToDataSettingsCommand}"
                                Padding="10,6"
                                ToolTip="Manage backups, restore, and retention in Settings"
                                AutomationProperties.Name="Open Data Settings Button">
                            <TextBlock Text="Manage Backups →" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTealBrush}" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WIDE LAYOUT (Side-by-side tables when IsWide == true) -->
            <Grid Visibility="{Binding IsWide, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <!-- Recent Prescriptions Table (Wide) -->
                <Border Grid.Column="0" Style="{StaticResource CardContainer}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Recent Prescriptions" Style="{StaticResource HeadingSmall}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ViewAllPrescriptionsCommand}"
                                    HorizontalAlignment="Right" Padding="10,4"
                                    AutomationProperties.Name="View Prescription Archive">
                                <TextBlock Text="View Archive →" />
                            </Button>
                        </Grid>

                        <DataGrid ItemsSource="{Binding RecentPrescriptions}"
                                  Style="{StaticResource ModernDataGrid}"
                                  MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="RX Number" Binding="{Binding PrescriptionNumber}" Width="1.4*" MinWidth="110" />
                                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="2*" MinWidth="120" />
                                <DataGridTextColumn Header="Date" Binding="{Binding PrescriptionDate, StringFormat='dd MMM yyyy'}" Width="1.2*" MinWidth="95" />
                                <DataGridTemplateColumn Header="Status" Width="1*" MinWidth="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SuccessGreenLightBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Items" Binding="{Binding MedicineCount}" Width="0.8*" MinWidth="55" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Recent Patients Table (Wide) -->
                <Border Grid.Column="2" Style="{StaticResource CardContainer}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Recent Patients" Style="{StaticResource HeadingSmall}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ViewAllPatientsCommand}"
                                    HorizontalAlignment="Right" Padding="10,4"
                                    AutomationProperties.Name="View All Patients">
                                <TextBlock Text="All Patients →" />
                            </Button>
                        </Grid>

                        <DataGrid ItemsSource="{Binding RecentPatients}"
                                  Style="{StaticResource ModernDataGrid}"
                                  MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MRN" Binding="{Binding Id, StringFormat='#{0}'}" Width="1*" MinWidth="60" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="110" />
                                <DataGridTextColumn Header="Age / Gender" Binding="{Binding DisplayAgeGender}" Width="1.2*" MinWidth="85" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding FormattedPhone}" Width="1.4*" MinWidth="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- NORMAL / COMPACT LAYOUT (Stacked tables when IsWide == false) -->
            <StackPanel Visibility="{Binding IsWide, Converter={StaticResource InverseBoolToVisConverter}}" Margin="0,0,0,16">
                <!-- Recent Prescriptions Table (Stacked) -->
                <Border Style="{StaticResource CardContainer}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Recent Prescriptions" Style="{StaticResource HeadingSmall}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ViewAllPrescriptionsCommand}"
                                    HorizontalAlignment="Right" Padding="10,4"
                                    AutomationProperties.Name="View Prescription Archive">
                                <TextBlock Text="View Archive →" />
                            </Button>
                        </Grid>

                        <DataGrid ItemsSource="{Binding RecentPrescriptions}"
                                  Style="{StaticResource ModernDataGrid}"
                                  MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="RX Number" Binding="{Binding PrescriptionNumber}" Width="1.5*" MinWidth="110" />
                                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="2*" MinWidth="120" />
                                <DataGridTextColumn Header="Date" Binding="{Binding PrescriptionDate, StringFormat='dd MMM yyyy'}" Width="1.2*" MinWidth="95" />
                                <!-- Status badge: visible in Normal, hidden in Compact -->
                                <DataGridTemplateColumn Header="Status" Width="1*" MinWidth="75"
                                                        Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SuccessGreenLightBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Items: hidden in Compact -->
                                <DataGridTextColumn Header="Items" Binding="{Binding MedicineCount}" Width="0.8*" MinWidth="50"
                                                    Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisConverter}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Recent Patients Table (Stacked) -->
                <Border Style="{StaticResource CardContainer}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Recent Patients" Style="{StaticResource HeadingSmall}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ViewAllPatientsCommand}"
                                    HorizontalAlignment="Right" Padding="10,4"
                                    AutomationProperties.Name="View All Patients">
                                <TextBlock Text="All Patients →" />
                            </Button>
                        </Grid>

                        <DataGrid ItemsSource="{Binding RecentPatients}"
                                  Style="{StaticResource ModernDataGrid}"
                                  MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MRN" Binding="{Binding Id, StringFormat='#{0}'}" Width="1*" MinWidth="60" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="110" />
                                <DataGridTextColumn Header="Age / Gender" Binding="{Binding DisplayAgeGender}" Width="1.4*" MinWidth="85" />
                                <!-- Phone: hidden in Compact to avoid horizontal scrolling -->
                                <DataGridTextColumn Header="Phone" Binding="{Binding FormattedPhone}" Width="1.6*" MinWidth="95"
                                                    Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisConverter}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
