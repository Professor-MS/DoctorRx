<Window x:Class="DoctorRx.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DoctorRx.Presentation.ViewModels"
        xmlns:views="clr-namespace:DoctorRx.Presentation.Views"
        mc:Ignorable="d"
        Title="DoctorRx - Clinical Prescription Management" 
        Height="800" Width="1240"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SlateBackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <!-- DataTemplates mapping ViewModels to their respective Views -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PatientsViewModel}">
            <views:PatientsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NewPrescriptionViewModel}">
            <views:ScaffoldedFeatureView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrescriptionHistoryViewModel}">
            <views:ScaffoldedFeatureView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MedicinesViewModel}">
            <views:ScaffoldedFeatureView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:ScaffoldedFeatureView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Navigation Sidebar -->
            <ColumnDefinition Width="240" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource SlateDarkestBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Items -->
                    <RowDefinition Height="*" />
                    <!-- Doctor Profile Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand / Logo Header -->
                <Border Grid.Row="0" Padding="20,24,20,20" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Modern Rx Pill / Cross Icon -->
                        <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource PrimaryTealDarkBrush}" Margin="0,0,12,0">
                            <TextBlock Text="Rx" Foreground="White" FontSize="18" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DoctorRx" Foreground="White" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Prescription Suite" Foreground="{StaticResource SlateLightBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation Rail Tabs -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,16">
                    <StackPanel>
                        <!-- Section Label -->
                        <TextBlock Text="MAIN NAVIGATION" Foreground="{StaticResource SlateMutedBrush}" 
                                   FontSize="10.5" FontWeight="SemiBold" Margin="24,0,0,10" />

                        <!-- Dashboard Button -->
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateToDashboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Margin="0,0,12,0" FontSize="14" />
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- New Prescription Button -->
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateToNewPrescriptionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝" Margin="0,0,12,0" FontSize="14" />
                                <TextBlock Text="New Prescription" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Patients Button -->
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateToPatientsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" Margin="0,0,12,0" FontSize="14" />
                                <TextBlock Text="Patients" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Prescription History Button -->
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateToHistoryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📜" Margin="0,0,12,0" FontSize="14" />
                                <TextBlock Text="Prescription History" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Medicines Button -->
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateToMedicinesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💊" Margin="0,0,12,0" FontSize="14" />
                                <TextBlock Text="Medicines" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Section Label -->
                        <TextBlock Text="SYSTEM" Foreground="{StaticResource SlateMutedBrush}" 
                                   FontSize="10.5" FontWeight="SemiBold" Margin="24,20,0,10" />

                        <!-- Settings Button -->
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding NavigateToSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Margin="0,0,12,0" FontSize="14" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Active Doctor Profile Footer -->
                <Border Grid.Row="2" Background="#0B1120" Padding="16,14" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Doctor Avatar -->
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" 
                                Background="#1E293B" Margin="0,0,10,0">
                            <TextBlock Text="👨‍⚕️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveDoctor.Name, FallbackValue='Dr. Muhammad Tariq'}" 
                                       Foreground="White" FontSize="12.5" FontWeight="SemiBold" 
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ActiveDoctor.Specialization, FallbackValue='Consultant Physician'}" 
                                       Foreground="{StaticResource SlateLightBrush}" FontSize="11" 
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT AREA ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Header Bar -->
                <RowDefinition Height="64" />
                <!-- Screen Body -->
                <RowDefinition Height="*" />
                <!-- Status Bar -->
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceWhiteBrush}" 
                    BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="30,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Active Page Title -->
                    <TextBlock Grid.Column="0" Text="{Binding CurrentViewTitle}" 
                               Style="{StaticResource HeadingMedium}" VerticalAlignment="Center" />

                    <!-- Top Bar Badges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Local Offline Status Badge -->
                        <Border Background="{StaticResource SuccessGreenLightBrush}" 
                                CornerRadius="12" Padding="10,4" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessGreenBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Offline-First • Local SQLite" Foreground="{StaticResource SuccessGreenBrush}" 
                                           FontSize="11.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Current Date -->
                        <TextBlock Text="{Binding CurrentDateFormatted}" 
                                   Foreground="{StaticResource SlateMutedBrush}" 
                                   FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Current View Host -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceWhiteBrush}" 
                    BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="DoctorRx v1.0.0 • Clean Architecture • EF Core SQLite Engine Ready" 
                               Foreground="{StaticResource SlateLightBrush}" FontSize="11" />

                    <TextBlock Grid.Column="1" Text="Visual Studio 2026 Compatible • .NET 10 LTS" 
                               Foreground="{StaticResource SlateLightBrush}" FontSize="11" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
