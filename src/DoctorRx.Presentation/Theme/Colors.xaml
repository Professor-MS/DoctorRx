<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Medical Teal Palette -->
    <Color x:Key="PrimaryTealDarkColor">#0F766E</Color>
    <Color x:Key="PrimaryTealColor">#0D9488</Color>
    <Color x:Key="PrimaryTealLightColor">#14B8A6</Color>
    <Color x:Key="PrimaryTealUltraLightColor">#CCFBF1</Color>

    <!-- Cool Slate / Neutral Palette -->
    <Color x:Key="SlateDarkestColor">#0F172A</Color>
    <Color x:Key="SlateDarkColor">#1E293B</Color>
    <Color x:Key="SlateMediumColor">#334155</Color>
    <Color x:Key="SlateMutedColor">#64748B</Color>
    <Color x:Key="SlateLightColor">#94A3B8</Color>
    <Color x:Key="SlateBorderColor">#E2E8F0</Color>
    <Color x:Key="SlateBorderLightColor">#F1F5F9</Color>
    <Color x:Key="SlateBackgroundColor">#F8FAFC</Color>
    <Color x:Key="SurfaceWhiteColor">#FFFFFF</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="SuccessGreenColor">#10B981</Color>
    <Color x:Key="SuccessGreenLightColor">#D1FAE5</Color>
    <Color x:Key="WarningAmberColor">#F59E0B</Color>
    <Color x:Key="WarningAmberLightColor">#FEF3C7</Color>
    <Color x:Key="DangerRedColor">#EF4444</Color>
    <Color x:Key="DangerRedLightColor">#FEE2E2</Color>
    <Color x:Key="InfoSkyColor">#0284C7</Color>
    <Color x:Key="InfoSkyLightColor">#E0F2FE</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="PrimaryTealDarkBrush" Color="{StaticResource PrimaryTealDarkColor}" />
    <SolidColorBrush x:Key="PrimaryTealBrush" Color="{StaticResource PrimaryTealColor}" />
    <SolidColorBrush x:Key="PrimaryTealLightBrush" Color="{StaticResource PrimaryTealLightColor}" />
    <SolidColorBrush x:Key="PrimaryTealUltraLightBrush" Color="{StaticResource PrimaryTealUltraLightColor}" />

    <SolidColorBrush x:Key="SlateDarkestBrush" Color="{StaticResource SlateDarkestColor}" />
    <SolidColorBrush x:Key="SlateDarkBrush" Color="{StaticResource SlateDarkColor}" />
    <SolidColorBrush x:Key="SlateMediumBrush" Color="{StaticResource SlateMediumColor}" />
    <SolidColorBrush x:Key="SlateMutedBrush" Color="{StaticResource SlateMutedColor}" />
    <SolidColorBrush x:Key="SlateLightBrush" Color="{StaticResource SlateLightColor}" />
    <SolidColorBrush x:Key="SlateBorderBrush" Color="{StaticResource SlateBorderColor}" />
    <SolidColorBrush x:Key="SlateBorderLightBrush" Color="{StaticResource SlateBorderLightColor}" />
    <SolidColorBrush x:Key="SlateBackgroundBrush" Color="{StaticResource SlateBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceWhiteBrush" Color="{StaticResource SurfaceWhiteColor}" />

    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}" />
    <SolidColorBrush x:Key="SuccessGreenLightBrush" Color="{StaticResource SuccessGreenLightColor}" />
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmberColor}" />
    <SolidColorBrush x:Key="WarningAmberLightBrush" Color="{StaticResource WarningAmberLightColor}" />
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRedColor}" />
    <SolidColorBrush x:Key="DangerRedLightBrush" Color="{StaticResource DangerRedLightColor}" />
    <SolidColorBrush x:Key="InfoSkyBrush" Color="{StaticResource InfoSkyColor}" />
    <SolidColorBrush x:Key="InfoSkyLightBrush" Color="{StaticResource InfoSkyLightColor}" />

</ResourceDictionary>
